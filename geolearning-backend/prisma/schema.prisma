generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(dbgenerated("gen_random_uuid()"))
  name                     String
  email                    String               @unique
  role                     Role                 @default(STUDENT)
  xp                       Int                  @default(0)
  level                    Int                  @default(1)
  avatar_url               String?
  equipped_badge_id        String?
  current_streak           Int                  @default(0)
  longest_streak           Int                  @default(0)
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt
  nis_nip                  String?
  school_class             String?
  verification_status      VerificationStatus   @default(UNVERIFIED)
  learning_style           String?
  bio                      String?
  enrollments              ClassStudent[]       @relation("StudentEnrollments")
  taught_classes           Class[]              @relation("TeacherClasses")
  interventions_received   Intervention[]       @relation("StudentInterventions")
  interventions_given      Intervention[]       @relation("TeacherInterventions")
  used_codes               InvitationCodeLog[]  @relation("TeacherUsedCodes")
  created_codes            InvitationCode[]     @relation("AdminCreatedCodes")
  materialCompletions      MaterialCompletion[]
  teacher_unlocked_modules ModuleUnlock[]       @relation("TeacherUnlockedModules")
  unlocked_modules         ModuleUnlock[]       @relation("UnlockedModules")
  notifications            Notification[]
  projectSubmissions       ProjectSubmission[]
  quiz_attempts            QuizAttempt[]
  created_quizzes          Quiz[]               @relation("TeacherQuizzes")
  resources                TeacherResource[]    @relation("TeacherResources")
  badges                   UserBadge[]          @relation("OwnedBadges")
  equipped_badge           UserBadge?           @relation("EquippedBadge", fields: [equipped_badge_id], references: [id])
  xp_logs                  XpLog[]

  @@map("users")
}

model Class {
  id                 String              @id @default(dbgenerated("gen_random_uuid()"))
  name               String
  description        String?
  teacher_id         String
  join_code          String              @unique @default(cuid())
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  gamification_mode  GamificationMode    @default(STANDARD)
  flashcards         Json?
  grade_level        Int?
  enrollments        ClassStudent[]
  teacher            User                @relation("TeacherClasses", fields: [teacher_id], references: [id], onDelete: Cascade)
  modules            Module[]
  projectAssignments ProjectAssignment[]
  quizzes            Quiz[]

  @@map("classes")
}

model ClassStudent {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  class_id   String
  student_id String
  joined_at  DateTime @default(now())
  no_absen   Int?
  class      Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student    User     @relation("StudentEnrollments", fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@map("class_students")
}

model Badge {
  id           String      @id
  display_name String
  description  String
  icon         String
  created_at   DateTime    @default(now())
  user_badges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  user_id           String
  badge_id          String
  earned_at         DateTime @default(now())
  badge             Badge    @relation(fields: [badge_id], references: [id])
  user              User     @relation("OwnedBadges", fields: [user_id], references: [id], onDelete: Cascade)
  equipped_by_users User[]   @relation("EquippedBadge")

  @@unique([user_id, badge_id])
  @@map("user_badges")
}

model Module {
  id          String         @id @default(dbgenerated("gen_random_uuid()"))
  class_id    String
  title       String
  description String?
  order       Int            @default(0)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  materials   Material[]
  unlocks     ModuleUnlock[]
  class       Class          @relation(fields: [class_id], references: [id], onDelete: Cascade)
  quizzes     Quiz[]

  @@map("modules")
}

model Material {
  id                  String               @id @default(dbgenerated("gen_random_uuid()"))
  module_id           String
  title               String
  type                MaterialType         @default(TEXT)
  content_url         String?
  content_text        String?
  order               Int                  @default(0)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  is_published        Boolean              @default(true)
  xp_reward           Int                  @default(15)
  materialCompletions MaterialCompletion[]
  module              Module               @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@map("materials")
}

model MaterialCompletion {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  user_id     String
  material_id String
  created_at  DateTime @default(now())
  material    Material @relation(fields: [material_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, material_id])
  @@map("material_completions")
}

model Quiz {
  id            String        @id @default(dbgenerated("gen_random_uuid()"))
  module_id     String?
  title         String
  time_limit    Int?
  xp_reward     Int           @default(10)
  is_published  Boolean       @default(false)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  class_id      String?
  order         Int           @default(0)
  passing_score Float?        @default(0)
  teacher_id    String?
  max_attempts  Int?
  quiz_type     String        @default("FORMATIF")
  questions     Question[]
  attempts      QuizAttempt[]
  class         Class?        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  module        Module?       @relation(fields: [module_id], references: [id], onDelete: Cascade)
  teacher       User?         @relation("TeacherQuizzes", fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model Question {
  id              String              @id @default(dbgenerated("gen_random_uuid()"))
  quiz_id         String
  text            String
  options         Json
  correct_answer  String
  explanation     String?
  order           Int                 @default(0)
  created_at      DateTime            @default(now())
  type            QuestionType        @default(MULTIPLE_CHOICE)
  duration        Int?
  points          Int?
  image_url       String?
  quiz            Quiz                @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  attempt_answers QuizAttemptAnswer[]

  @@map("questions")
}

model QuizAttempt {
  id               String              @id @default(dbgenerated("gen_random_uuid()"))
  quiz_id          String
  user_id          String
  score            Float               @default(0)
  xp_earned        Int                 @default(0)
  answers          Json?
  completed_at     DateTime?
  started_at       DateTime            @default(now())
  detailed_answers QuizAttemptAnswer[]
  quiz             Quiz                @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String      @id @default(dbgenerated("gen_random_uuid()"))
  attempt_id       String
  question_id      String
  is_correct       Boolean
  selected_options Json?
  attempt          QuizAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("quiz_attempt_answers")
}

model XpLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  user_id      String
  amount       Int
  source       String
  reference_id String?
  created_at   DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("xp_logs")
}

model ProjectAssignment {
  id                String              @id @default(dbgenerated("gen_random_uuid()"))
  class_id          String
  title             String
  description       String
  deadline          DateTime?
  xp_reward         Int                 @default(100)
  is_published      Boolean             @default(false)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  is_group_project  Boolean             @default(false)
  steam_integration Json?
  instruction_file_url String?
  class             Class               @relation(fields: [class_id], references: [id], onDelete: Cascade)
  submissions       ProjectSubmission[]

  @@map("project_assignments")
}

model ProjectSubmission {
  id            String            @id @default(dbgenerated("gen_random_uuid()"))
  assignment_id String
  user_id       String
  file_url      String?
  notes         String?
  score         Float?
  xp_earned     Int               @default(0)
  graded_at     DateTime?
  submitted_at  DateTime          @default(now())
  group_members Json?
  feedback      String?
  assignment    ProjectAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("project_submissions")
}

model ModuleUnlock {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  user_id    String
  module_id  String
  teacher_id String
  note       String?
  created_at DateTime @default(now())
  module     Module   @relation(fields: [module_id], references: [id], onDelete: Cascade)
  teacher    User     @relation("TeacherUnlockedModules", fields: [teacher_id], references: [id], onDelete: Cascade)
  user       User     @relation("UnlockedModules", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, module_id])
  @@map("module_unlocks")
}

model Intervention {
  id         String           @id @default(dbgenerated("gen_random_uuid()"))
  teacher_id String
  student_id String
  note       String
  type       InterventionType @default(ACADEMIC)
  resolved   Boolean          @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  student    User             @relation("StudentInterventions", fields: [student_id], references: [id], onDelete: Cascade)
  teacher    User             @relation("TeacherInterventions", fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("interventions")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()"))
  user_id    String
  message    String
  is_read    Boolean          @default(false)
  type       NotificationType @default(SYSTEM)
  metadata   Json?
  created_at DateTime         @default(now())
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model InvitationCode {
  id            String              @id @default(dbgenerated("gen_random_uuid()"))
  code          String              @unique
  created_by_id String
  expires_at    DateTime?
  max_uses      Int?
  times_used    Int                 @default(0)
  is_active     Boolean             @default(true)
  created_at    DateTime            @default(now())
  logs          InvitationCodeLog[]
  created_by    User                @relation("AdminCreatedCodes", fields: [created_by_id], references: [id])

  @@map("invitation_codes")
}

model InvitationCodeLog {
  id                 String         @id @default(dbgenerated("gen_random_uuid()"))
  invitation_code_id String
  used_by_id         String
  used_at            DateTime       @default(now())
  invitation_code    InvitationCode @relation(fields: [invitation_code_id], references: [id])
  used_by            User           @relation("TeacherUsedCodes", fields: [used_by_id], references: [id])

  @@map("invitation_code_logs")
}

model TeacherResource {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  teacher_id  String
  title       String
  description String?
  type        MaterialType @default(TEXT)
  file_url    String?
  content     Json?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  xp_reward   Int          @default(15)
  teacher     User         @relation("TeacherResources", fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("teacher_resources")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  SUSPENDED
}

enum GamificationMode {
  STANDARD
  COMPETITIVE
}

enum MaterialType {
  VIDEO
  PDF
  TEXT
  LINK
  IMAGE
  INTERACTIVE_MAP
  SIMULATION
  QUIZ
}

enum NotificationType {
  ACHIEVEMENT
  REMINDER
  INTERVENTION
  SYSTEM
}

enum InterventionType {
  ACADEMIC
  BEHAVIORAL
  ATTENDANCE
  EMOTIONAL
  POSITIVE
  CORRECTIVE
}

enum QuestionType {
  MULTIPLE_CHOICE
  MAP_PINPOINT
}
